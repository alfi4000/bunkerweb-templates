{
  "id": "sealfile-template",
  "name": "Sealfile Template",
  "settings": {
    "IS_DRAFT": "no",
    "SERVER_NAME": "domain.com",
    "USE_ANTIBOT": "javascript",
    "ANTIBOT_IGNORE_URI": "^/build/ ^/api/ ^/api2/ ^/seafhttp/ ^/share/ ^/uploads ^/zip-downloads ^/thumbnail/ ^/office-convert/ ^/seafile-office-web/",
    "BAD_BEHAVIOR_THRESHOLD": "20",
    "USE_CLAMAV": "yes",
    "CLIENT_CACHE_ETAG": "no",
    "USE_CROWDSEC": "yes",
    "CROWDSEC_API": "http://127.0.0.1:8080/",
    "CROWDSEC_API_KEY": "your-key",
    "CROWDSEC_APPSEC_URL": "http://127.0.0.1:7422/",
    "INTERCEPTED_ERROR_CODES": "404 405 413 429 500 501 502 503 504",
    "GZIP_PROXIED": "expired no-cache no-store private auth",
    "KEEP_UPSTREAM_HEADERS": "Content-Security-Policy Strict-Transport-Security X-Frame-Options X-Content-Type-Options Referrer-Policy",
    "COOKIE_FLAGS_4": "sfcsrftoken SameSite=Lax",
    "AUTO_LETS_ENCRYPT": "yes",
    "EMAIL_LETS_ENCRYPT": "registration@domain.com",
    "LIMIT_CONN_MAX_HTTP1": "50",
    "LIMIT_CONN_MAX_HTTP2": "500",
    "LIMIT_CONN_MAX_HTTP3": "500",
    "LIMIT_REQ_RATE": "25r/s",
    "LIMIT_REQ_URL_1": "^/api2/",
    "LIMIT_REQ_RATE_1": "50r/s",
    "LIMIT_REQ_URL_2": "^/seafhttp/",
    "LIMIT_REQ_RATE_2": "50r/s",
    "ALLOWED_METHODS": "GET|POST|HEAD|PUT|DELETE|PATCH|OPTIONS|PROPFIND|MKCOL|COPY|MOVE|LOCK|UNLOCK",
    "MAX_CLIENT_SIZE": "20m",
    "SERVE_FILES": "no",
    "USE_REVERSE_PROXY": "yes",
    "REVERSE_PROXY_INTERCEPT_ERRORS": "no",
    "PROXY_BUFFERS": "8 32k",
    "PROXY_BUFFER_SIZE": "32k",
    "PROXY_BUSY_BUFFERS_SIZE": "64k",
    "REVERSE_PROXY_HOST": "http://ip:port",
    "REVERSE_PROXY_WS": "yes",
    "REVERSE_PROXY_BUFFERING": "no",
    "REVERSE_PROXY_REQUEST_BUFFERING": "no",
    "REVERSE_PROXY_READ_TIMEOUT": "3600s",
    "REVERSE_PROXY_SEND_TIMEOUT": "3600s",
    "USE_ROBOTSTXT": "yes",
    "USE_SYSWARDEN_BLOCKLIST": "yes",
    "USE_SYSWARDEN_WHITELIST": "yes"
  },
  "configs": [],
  "steps": [
    {
      "title": "SSL / Let's Encrypt",
      "subtitle": "Configure ssl / let's encrypt settings.",
      "settings": [
        "AUTO_LETS_ENCRYPT",
        "EMAIL_LETS_ENCRYPT"
      ]
    },
    {
      "title": "Reverse Proxy",
      "subtitle": "Configure reverse proxy settings.",
      "settings": [
        "USE_REVERSE_PROXY",
        "REVERSE_PROXY_INTERCEPT_ERRORS",
        "REVERSE_PROXY_HOST",
        "REVERSE_PROXY_WS",
        "REVERSE_PROXY_BUFFERING",
        "REVERSE_PROXY_REQUEST_BUFFERING",
        "REVERSE_PROXY_READ_TIMEOUT",
        "REVERSE_PROXY_SEND_TIMEOUT"
      ]
    },
    {
      "title": "Rate Limiting",
      "subtitle": "Configure rate limiting settings.",
      "settings": [
        "LIMIT_CONN_MAX_HTTP1",
        "LIMIT_CONN_MAX_HTTP2",
        "LIMIT_CONN_MAX_HTTP3",
        "LIMIT_REQ_RATE",
        "LIMIT_REQ_URL_1",
        "LIMIT_REQ_RATE_1",
        "LIMIT_REQ_URL_2",
        "LIMIT_REQ_RATE_2"
      ]
    },
    {
      "title": "Security",
      "subtitle": "Configure security settings.",
      "settings": [
        "USE_ANTIBOT",
        "ANTIBOT_IGNORE_URI",
        "BAD_BEHAVIOR_THRESHOLD"
      ]
    },
    {
      "title": "Performance",
      "subtitle": "Configure performance settings.",
      "settings": [
        "CLIENT_CACHE_ETAG",
        "GZIP_PROXIED",
        "MAX_CLIENT_SIZE",
        "SERVE_FILES"
      ]
    },
    {
      "title": "Whitelist / Allowlist",
      "subtitle": "Configure whitelist / allowlist settings.",
      "settings": [
        "USE_SYSWARDEN_WHITELIST"
      ]
    },
    {
      "title": "Server / Core",
      "subtitle": "Configure server / core settings.",
      "settings": [
        "IS_DRAFT",
        "SERVER_NAME",
        "INTERCEPTED_ERROR_CODES",
        "ALLOWED_METHODS"
      ]
    },
    {
      "title": "Other",
      "subtitle": "Configure other settings.",
      "settings": [
        "USE_CLAMAV",
        "USE_CROWDSEC",
        "CROWDSEC_API",
        "CROWDSEC_API_KEY",
        "CROWDSEC_APPSEC_URL",
        "KEEP_UPSTREAM_HEADERS",
        "COOKIE_FLAGS_4",
        "PROXY_BUFFERS",
        "PROXY_BUFFER_SIZE",
        "PROXY_BUSY_BUFFERS_SIZE",
        "USE_ROBOTSTXT",
        "USE_SYSWARDEN_BLOCKLIST"
      ]
    }
  ]
}
